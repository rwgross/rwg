<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_saleorder_hide_allocation_lines"
              inherit_id="sale.report_saleorder_document"
              name="Hide warehouse allocation lines from customer sales report">
        <xpath expr="//t[@t-set='lines_to_report']" position="attributes">
            <attribute name="t-value">doc._get_order_lines_to_report().filtered(lambda l: not l.x_rg_allocation_technical)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']//span[@t-field='line.product_uom_qty']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">line.x_rg_report_qty or line.product_uom_qty</attribute>
            <attribute name="t-options">{'widget': 'float', 'decimal_precision': 'Product Unit'}</attribute>
        </xpath>
        <xpath expr="//span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-field"/>
            <attribute name="t-out">line.x_rg_report_subtotal or line.price_subtotal</attribute>
        </xpath>
    </template>

    <template id="portal_saleorder_hide_allocation_lines"
              inherit_id="sale.sale_order_portal_content"
              name="Hide warehouse allocation lines from customer portal preview">
        <xpath expr="//t[@t-set='lines_to_report']" position="attributes">
            <attribute name="t-value">sale_order._get_order_lines_to_report().filtered(lambda l: not l.x_rg_allocation_technical)</attribute>
        </xpath>
        <xpath expr="//td[@name='td_product_quantity']" position="replace">
            <td name="td_product_quantity" class="text-end">
                <div id="quote_qty">
                    <span t-out="line.x_rg_report_qty or line.product_uom_qty"
                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit'}"/>
                    <span t-field="line.product_uom_id"/>
                </div>
            </td>
        </xpath>
        <xpath expr="//td[@name='td_product_subtotal']" position="replace">
            <td t-if="not line.is_downpayment" name="td_product_subtotal" class="text-end">
                <t t-if="not collapse_prices">
                    <span t-if="price_field == 'price_subtotal'"
                          t-out="line.x_rg_report_subtotal or line.price_subtotal"
                          t-options="{'widget': 'monetary', 'display_currency': sale_order.currency_id}"/>
                    <span t-else="" t-field="line.price_total"/>
                </t>
            </td>
        </xpath>
    </template>
</odoo>
