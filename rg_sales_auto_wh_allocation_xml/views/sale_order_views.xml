<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sale_order_confirm_allocate" model="ir.ui.view">
        <field name="name">sale.order.form.confirm.allocate.warehouses</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_confirm' and @invisible=&quot;state != 'draft'&quot;]" position="before">
                <button
                    string="Confirm &amp; Allocate WH"
                    name="%(rg_sales_auto_wh_allocation_xml.action_confirm_allocate_wh)d"
                    type="action"
                    context="{'validate_analytic': True}"
                    class="btn-primary"
                    data-hotkey="q"
                    invisible="state != 'draft'"/>
            </xpath>
        </field>
    </record>
</odoo>
