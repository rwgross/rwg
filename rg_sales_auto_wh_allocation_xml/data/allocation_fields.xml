<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="field_sale_order_line_allocation_technical" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="model">sale.order.line</field>
        <field name="name">x_rg_allocation_technical</field>
        <field name="field_description">Warehouse Allocation Line</field>
        <field name="help">Technical allocation line hidden from customer sales-order reports.</field>
        <field name="ttype">boolean</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
        <field name="copied" eval="False"/>
    </record>
    <record id="field_sale_order_line_report_qty" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="model">sale.order.line</field>
        <field name="name">x_rg_report_qty</field>
        <field name="field_description">Customer Report Quantity</field>
        <field name="help">Original commercial quantity shown on the customer sales-order report.</field>
        <field name="ttype">float</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
        <field name="copied" eval="False"/>
    </record>
    <record id="field_sale_order_line_report_subtotal" model="ir.model.fields">
        <field name="model_id" ref="sale.model_sale_order_line"/>
        <field name="model">sale.order.line</field>
        <field name="name">x_rg_report_subtotal</field>
        <field name="field_description">Customer Report Subtotal</field>
        <field name="help">Original commercial subtotal shown on the customer sales-order report.</field>
        <field name="ttype">monetary</field>
        <field name="currency_field">currency_id</field>
        <field name="state">manual</field>
        <field name="store" eval="True"/>
        <field name="copied" eval="False"/>
    </record>
</odoo>
